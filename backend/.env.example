# Porta da aplicação
PORT=3000

# String de conexão do MongoDB Atlas (ver docs/09_TECH_STACK.md)
MONGODB_URI=

# Segredo usado para assinar o JWT — nunca um valor real neste arquivo
JWT_SECRET=

# Expiração do JWT (ex.: 1d, 12h, 30m) — ver tasks/001_autenticacao.md, Seção 13
JWT_EXPIRES_IN=1d

# Origem permitida para requisições do frontend (CORS)
CORS_ORIGIN=http://localhost:5173
